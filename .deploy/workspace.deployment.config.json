{
  "$schema": "deployment.config.schema.json",
  "options": {
    "authenticationServerType": "local"
  },
  "globals": {
    "appUrl": "${APP_URL:-}",
    "authenticationTrustedOrigins": "${APP_URL},${DESIGNER_URL},http://localhost:8080,http://localhost:8081,https://localhost:8080,https://localhost:8081",
    "authenticationUrl": "${AUTH_URL:-http://auth_server:3000}",
    "automationHubImage": "docker.cloudsmith.io/buildone/repository/automation-hub-1-121-2-1:1.12.0",
    "automationHubDBImage": "docker.cloudsmith.io/buildone/repository/automation-hub-db:1.12.0",
    "postgresDbImage": "docker.cloudsmith.io/buildone/repository/build-one-postgres-db:17-2",
    "caddyImage": "docker.cloudsmith.io/buildone/repository/buildone-caddy:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1",
    "swatAppServerTsImage": "docker.cloudsmith.io/buildone/repository/buildone-swat-app-server-ts:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1",
    "appServerTsImage": "docker.cloudsmith.io/buildone/repository/buildone-app-server-ts:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1",
    "webAppImage": "docker.cloudsmith.io/buildone/repository/buildone-web-app:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1"
  },
  "volumes": [
    "ah_db_storage",
    "app_db_storage",
    "b1_db_storage",
    "swat_app_uploads",
    "auth_db_storage"
  ],
  "networks": [
    "app-network"
  ],
  "services": {
    "caddy": {
      "image": "#globals.caddyImage",
      "restart": "unless-stopped",
      "networks": [
        "app-network"
      ],
      "command": [
        "caddy",
        "run",
        "--config",
        "/etc/caddy/Caddyfile",
        "--adapter",
        "caddyfile"
      ],
      "ports": {
        "8080": "8080",
        "8081": "8081"
      }
    },
    "b1_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "b1_db_storage"
      },
      "ports": {
        "5432": "5432"
      }
    },
    "swat_app_server_ts": {
      "image": "#globals.swatAppServerTsImage",
      "restart": "unless-stopped",
      "environment": {
        "APP_URL": "#globals.appUrl",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "IMPORT_DATA": "false",
        "PORT": "3000",
        "UPLOAD_DIR": "/app-data/uploads",
        "B1_DATA_FOLDER": "/data/b1",
        "APP_DATA_FOLDER": "/data/app",
        "B1_DATABASE_URL": "${B1_DATABASE_URL:-postgres://${B1_DATABASE_CREDENTIALS:-}@b1_db_server:5432/b1?sslmode=disable}",
        "AUTH_URL": "#globals.authenticationUrl",
        "B1_FRAMEWORK_DEVELOPMENT": "false"
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/app-data": "${WORKSPACE_ROOT}/data",
        "/data/b1": "${WORKSPACE_ROOT}/node_modules/@buildone/swat-data",
        "/data/app": "${WORKSPACE_ROOT}/src/data",
        "/tmp/secrets/automationhub": "${BUILDONE_CLI_WORKSPACE}/automationhub"
      },
      "depends_on": {
        "b1_db_server": {
          "condition": "service_healthy"
        }
      },
      "init": true,
      "ports": {
        "3000": "3000"
      }
    },
    "app_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "app_db",
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "app_db_storage"
      },
      "ports": {
        "5432": "15432"
      }
    },
    "app_server_ts": {
      "image": "nomad123/codespaces-nestjs-development:slim",
      "restart": "unless-stopped",
      "environment": {
        "PORT": "3000",
        "APP_DATABASE_URL": "${APP_DATABASE_URL:-postgres://${APP_DATABASE_CREDENTIALS:-}@app_db_server:5432/app_db?sslmode=disable}",
        "AUTH_URL": "#globals.authenticationUrl",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "NODE_ENV": "development"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "app_db_server": {
          "condition": "service_healthy"
        }
      },
      "init": true,
      "ports": {
        "3000": "3001",
        "9229": "3011"
      },
      "working_dir": "/workspace/src/app-server-ts",
      "command": "./start.sh",
      "volumes": {
        "/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "n8n_db_server": {
      "image": "#globals.automationHubDBImage",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "ah_db_storage"
      }
    },
    "n8n": {
      "image": "#globals.automationHubImage",
      "restart": "unless-stopped",
      "environment": {
        "SWAT_APP_SERVER_URL": "#globals.authenticationUrl",
        "AUTHENTICATION_URI": "#globals.authenticationUrl",
        "DB_POSTGRESDB_HOST": "n8n_db_server",
        "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "false",
        "N8N_SECURE_COOKIE": "false",
        "WEBHOOK_URL": "${N8N_URL}",
        "B1_N8N_ENV": "devel"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "n8n_db_server": {
          "condition": "service_healthy"
        }
      },
      "ports": {
        "5678": "5678"
      },
      "volumes": {
        "/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "web-app": {
      "image": "nomad123/codespaces-nestjs-development:slim",
      "restart": "unless-stopped",
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "NODE_ENV": "development",
        "APP_URL": "#globals.appUrl"
      },
      "networks": [
        "app-network"
      ],
      "working_dir": "/workspace/src/web-app",
      "command": "npm run dev",
      "volumes": {
        "/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "pg-admin": {
      "image": "dpage/pgadmin4:9",
      "restart": "unless-stopped",
      "environment": {
        "PGADMIN_CONFIG_X_FRAME_OPTIONS": "\"\"",
        "PGADMIN_CONFIG_ALLOW_FRAMING": "True",
        "PGADMIN_CONFIG_PROXY_X_HOST_COUNT": "1",
        "PGADMIN_CONFIG_PROXY_X_FOR_COUNT": "1",
        "PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION": "False",
        "PGADMIN_CONFIG_CSRF_TRUSTED_ORIGINS": "['https://*.github.dev']",
        "PGADMIN_DEFAULT_EMAIL": "${B1_AUTOMATION_HUB_EMAIL}",
        "PGADMIN_DEFAULT_PASSWORD": "${B1_AUTOMATION_HUB_PASSWORD}",
        "PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED": "False",
        "PGADMIN_CONFIG_ALLOW_SAVE_PASSWORD": "False",
        "PGADMIN_CONFIG_SERVER_MODE": "False",
        "PGADMIN_CONFIG_CONSOLE_LOG_LEVEL": "10"
      },
      "ports": {
        "80": "2021"
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/pgadmin4/servers.json": "${BUILDONE_CLI_WORKSPACE}/pgadmin.servers.json"
      }
    },
    "web-docs": {
      "image": "docker.cloudsmith.io/buildone/repository/buildone-web-docs:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1",
      "restart": "unless-stopped",
      "ports": {
        "80": "5173"
      }
    },
    "auth_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "auth_db",
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "auth_db_storage"
      },
      "ports": {
        "5432": "25432"
      }
    },
    "auth_server": {
      "image": "docker.cloudsmith.io/buildone/repository/buildone-auth-server:24.3.0-b1-399-toast-message-doesnt-work-on-starter.1",
      "restart": "unless-stopped",
      "environment": {
        "PORT": "3000",
        "APP_URL": "#globals.appUrl",
        "AUTH_DATABASE_URL": "${AUTH_DATABASE_URL:-postgres://${AUTH_DATABASE_CREDENTIALS:-}@auth_db_server:5432/auth_db?sslmode=disable}",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "B1_AUTOMATION_HUB_USER": "${B1_AUTOMATION_HUB_USER}",
        "B1_AUTOMATION_HUB_EMAIL": "${B1_AUTOMATION_HUB_EMAIL}",
        "B1_AUTOMATION_HUB_PASSWORD": "${B1_AUTOMATION_HUB_PASSWORD}",
        "AH_CREDENTIALS": "${AH_CREDENTIALS:-}",
        "AUTHENTICATION_TRUSTED_ORIGINS": "#globals.authenticationTrustedOrigins",
        "MICROSOFT_CLIENT_ID": "${MICROSOFT_CLIENT_ID:-}",
        "MICROSOFT_CLIENT_SECRET": "${MICROSOFT_CLIENT_SECRET:-}",
        "MICROSOFT_TENANT_ID": "${MICROSOFT_TENANT_ID:-}",
        "MICROSOFT_SCOPE": "${MICROSOFT_SCOPE:-}",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID:-}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET:-}",
        "GITHUB_CLIENT_ID": "${GITHUB_CLIENT_ID:-}",
        "GITHUB_CLIENT_SECRET": "${GITHUB_CLIENT_SECRET:-}",
        "NODE_ENV": "production"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "auth_db_server": {
          "condition": "service_healthy"
        }
      },
      "ports": {
        "3000": "3002",
        "9229": "3012"
      },
      "volumes": {
        "/tmp/secrets/automationhub": "${BUILDONE_CLI_WORKSPACE}/automationhub"
      }
    }
  }
}
