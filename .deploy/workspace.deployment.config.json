{
  "$schema": "deployment.config.schema.json",
  "globals": {
    "appUrl": "${APP_URL:-}",
    "authenticationOIDCRoleId": "${AUTHENTICATION_OIDC_ROLE_ID:-}",
    "authenticationTrustedOrigins": "${APP_URL},${DESIGNER_URL},http://localhost:8080,http://localhost:8081,https://localhost:8080,https://localhost:8081",
    "authenticationURI": "http://swat_app_server_ts:3000",
    "automationHubImage": "docker.cloudsmith.io/buildone/repository/automation-hub-1-114-3:1.9.4",
    "postgresDbImage": "docker.cloudsmith.io/buildone/repository/build-one-postgres-db:17-2",
    "caddyImage": "docker.cloudsmith.io/buildone/repository/buildone-caddy:${BUILDONE_VERSION}",
    "appServerTsImage": "docker.cloudsmith.io/buildone/repository/buildone-app-server-ts:${BUILDONE_VERSION}",
    "webAppImage": "docker.cloudsmith.io/buildone/repository/buildone-web-app:${BUILDONE_VERSION}"
  },
  "volumes": [
    "ah_db_storage",
    "app_db_storage",
    "b1_db_storage"
  ],
  "networks": [
    "app-network"
  ],
  "services": {
    "caddy": {
      "image": "#globals.caddyImage",
      "restart": "unless-stopped",
      "networks": [
        "app-network"
      ],
      "command": [
        "caddy",
        "run",
        "--config",
        "/etc/caddy/Caddyfile",
        "--adapter",
        "caddyfile"
      ],
      "ports": {
        "8080": "8080",
        "8081": "8081"
      }
    },
    "b1_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "b1_db_storage"
      },
      "ports": {
        "5432": "5432"
      }
    },
    "swat_app_server_ts": {
      "image": "docker.cloudsmith.io/buildone/repository/buildone-swat-app-server-ts:25.17.0-PVG.20",
      "restart": "unless-stopped",
      "environment": {
        "INIT_CREDENTIALS": "${CREDENTIALS:-}",
        "IMPORT_DATA": "false",
        "PORT": "3000",
        "UPLOAD_DIR": "/app-data/uploads",
        "B1_DATA_FOLDER": "/data/b1",
        "APP_DATA_FOLDER": "/data/app",
        "B1_DATABASE_URL": "${B1_DATABASE_URL:-postgres://${B1_DATABASE_CREDENTIALS:-}@b1_db_server:5432/b1?sslmode=disable}",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "BETTER_AUTH_URL": "${BETTER_AUTH_URL}",
        "B1_AUTOMATION_HUB_USER": "${B1_AUTOMATION_HUB_USER}",
        "B1_AUTOMATION_HUB_EMAIL": "${B1_AUTOMATION_HUB_EMAIL}",
        "B1_AUTOMATION_HUB_PASSWORD": "${B1_AUTOMATION_HUB_PASSWORD}",
        "AUTHENTICATION_URI": "#globals.authenticationURI",
        "AUTHENTICATION_TRUSTED_ORIGINS": "#globals.authenticationTrustedOrigins",
        "REPOSITORY_SERVICE_TYPE": "POSTGRES",
        "LEGACY_APPLICATION_APPURL": "#globals.appUrl",
        "LEGACY_AUTHENTICATION_ALLOWEDAUTHENTICATION": "${ALLOWED_AUTHENTICATION:-AkiomaUser}",
        "LEGACY_AUTHENTICATION_SSOAUTHENTICATIONURI": "#globals.authenticationURI",
        "LEGACY_AUTHENTICATION_AUTHENTICATIONOIDCROLEID": "#globals.authenticationOIDCRoleId",
        "LEGACY_ENVIRONMENT_URL": "#globals.appUrl",
        "LEGACY_INTEGRATION_GOOGLEAPIKEY": "${GOOGLEAPIKEY:-}",
        "LEGACY_INTEGRATION_KENDOLICENSEKEY": "${KENDO_LICENSE_KEY:-}"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "b1_db_server": {
          "condition": "service_healthy"
        }
      },
      "init": true,
      "ports": {
        "3000": "3000"
      },
      "volumes": {
        "/data/b1": "${WORKSPACE_ROOT}/node_modules/@buildone/swat-data",
        "/data/app": "${WORKSPACE_ROOT}/src/data",
        "/app-data": "${WORKSPACE_ROOT}/data"
      }
    },
    "app_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "app_db",
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "app_db_storage"
      },
      "ports": {
        "5432": "15432"
      }
    },
    "app_server_ts": {
      "image": "#skip",
      "restart": "unless-stopped",
      "environment": {
        "PORT": "3000",
        "APP_DATABASE_URL": "${APP_DATABASE_URL:-postgres://${APP_DATABASE_CREDENTIALS:-}@app_db_server:5432/app_db?sslmode=disable}",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "BETTER_AUTH_URL": "${BETTER_AUTH_URL}",
        "AUTHENTICATION_URI": "#globals.authenticationURI",
        "NODE_ENV": "development"
      },
      "networks": [
        "app-network",
        "app-network"
      ],
      "depends_on": {
        "app_db_server": {
          "condition": "service_healthy"
        }
      },
      "build": {
        "context": "${BUILDONE_CLI_WORKSPACE}/deploy",
        "dockerfile": "appserver.dev.Dockerfile"
      },
      "init": true,
      "ports": {
        "3000": "3001",
        "9229": "3011"
      },
      "working_dir": "/workspace/src/app-server-ts",
      "command": "./start.sh",
      "volumes": {
        "/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "n8n_db_server": {
      "image": "docker.cloudsmith.io/buildone/repository/automation-hub-db:16-1",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "ah_db_storage"
      }
    },
    "n8n_init": {
      "image": "#globals.automationHubImage",
      "restart": "no",
      "environment": {
        "DB_POSTGRESDB_HOST": "n8n_db_server"
      },
      "entrypoint": [
        "/db_init.sh"
      ],
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "n8n_db_server": {
          "condition": "service_healthy"
        }
      },
      "volumes": {
        "/workspace/logs": "${WORKSPACE_ROOT}/logs"
      }
    },
    "n8n": {
      "image": "#globals.automationHubImage",
      "restart": "unless-stopped",
      "environment": {
        "DB_POSTGRESDB_HOST": "n8n_db_server",
        "AUTHENTICATION_OIDC_ROLE_ID": "#globals.authenticationOIDCRoleId",
        "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "false",
        "N8N_SECURE_COOKIE": "false",
        "AUTHENTICATION_URI": "#globals.authenticationURI",
        "WEBHOOK_URL": "${N8N_URL}",
        "B1_N8N_ENV": "devel"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "n8n_init": {
          "condition": "service_completed_successfully"
        }
      },
      "ports": {
        "5678": "5678"
      },
      "volumes": {
        "/workspace/src": "${WORKSPACE_ROOT}/src",
        "/workspace/data": "${WORKSPACE_ROOT}/data",
        "/workspace/app/data": "/workspace/n8n",
        "/workspace/app/data/automation-hub": "${WORKSPACE_ROOT}/src/data/n8n",
        "/workspace/app/repository": "${WORKSPACE_ROOT}/src/data/repository",
        "/workspace/app/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "web-app": {
      "image": "#skip",
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "NODE_ENV": "development",
        "APP_URL": "#globals.appUrl"
      },
      "networks": [
        "app-network"
      ],
      "build": {
        "context": "${BUILDONE_CLI_WORKSPACE}/deploy",
        "dockerfile": "appserver.dev.Dockerfile"
      },
      "working_dir": "/workspace/src/web-app",
      "command": "npm run dev",
      "volumes": {
        "/workspace": "${WORKSPACE_ROOT}"
      }
    },
    "pg-admin": {
      "image": "dpage/pgadmin4:9",
      "restart": "unless-stopped",
      "environment": {
        "PGADMIN_DEFAULT_EMAIL": "${B1_AUTOMATION_HUB_EMAIL}",
        "PGADMIN_DEFAULT_PASSWORD": "${B1_AUTOMATION_HUB_PASSWORD}",
        "PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED": "False",
        "PGADMIN_CONFIG_ALLOW_SAVE_PASSWORD": "False",
        "PGADMIN_CONFIG_SERVER_MODE": "False",
        "PGADMIN_CONFIG_CONSOLE_LOG_LEVEL": "10"
      },
      "ports": {
        "80": "2021"
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/pgadmin4/servers.json": "${BUILDONE_CLI_WORKSPACE}/pgadmin.servers.json"
      }
    },
    "web-docs": {
      "image": "docker.cloudsmith.io/buildone/repository/buildone-web-docs:25.17.0-PVG.20",
      "ports": {
        "80": "5173"
      }
    }
  }
}
