{
  "$schema": "deployment.config.schema.json",
  "globals": {
    "appUrl": "${APP_URL:-${STACK}.${DOMAIN:-demo.build.one}}",
    "authenticationTrustedOrigins": "https://${APP_URL:-${STACK}.${DOMAIN:-demo.build.one}}",
    "authenticationURI": "http://swat_app_server_ts:3000",
    "automationHubImage": "docker.cloudsmith.io/buildone/repository/automation-hub-1-114-3-2:1.10.0",
    "automationHubDBImage": "docker.cloudsmith.io/buildone/repository/automation-hub-db:1.10.0",
    "postgresDbImage": "docker.cloudsmith.io/buildone/repository/build-one-postgres-db:17-2",
    "caddyImage": "docker.cloudsmith.io/buildone/repository/buildone-caddy:${BUILDONE_VERSION}",
    "swatAppServerTsImage": "docker.cloudsmith.io/buildone/repository/buildone-swat-app-server-ts:${BUILDONE_VERSION}",
    "appServerTsImage": "docker.cloudsmith.io/buildone/repository/buildone-app-server-ts:${BUILDONE_VERSION}",
    "webAppImage": "docker.cloudsmith.io/buildone/repository/buildone-web-app:${BUILDONE_VERSION}",
    "dataImage": "docker.cloudsmith.io/buildone/repository/buildone-data:${BUILDONE_VERSION}"
  },
  "volumes": [
    "ah_db_storage",
    "app_db_storage",
    "b1_db_storage",
    "swat_app_uploads",
    "app-data",
    "db-data",
    "n8n-data",
    "redis_storage"
  ],
  "networks": {
    "app-network": {
      "driver": "bridge",
      "driver_opts": {
        "com.docker.network.driver.mtu": 1430
      }
    },
    "traefik": {
      "external": true
    }
  },
  "services": {
    "caddy": {
      "image": "#globals.caddyImage",
      "restart": "unless-stopped",
      "networks": [
        "app-network",
        "traefik"
      ],
      "command": [
        "caddy",
        "run",
        "--config",
        "/etc/caddy/Caddyfile",
        "--adapter",
        "caddyfile"
      ],
      "labels": {
        "traefik.enable": "true",
        "traefik.docker.network": "traefik",
        "traefik.http.routers.${STACK}-buildone-app.rule": "Host(`${STACK}.${DOMAIN:-demo.build.one}`)",
        "traefik.http.routers.${STACK}-buildone-app.entrypoints": "${ENTRYPOINTS:-websecure}",
        "traefik.http.routers.${STACK}-buildone-app.tls.certresolver": "myresolver",
        "traefik.http.services.${STACK}-buildone-app.loadbalancer.server.port": "8080"
      }
    },
    "b1_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "b1_db_storage"
      }
    },
    "swat_app_server_ts": {
      "image": "#globals.swatAppServerTsImage",
      "restart": "unless-stopped",
      "environment": {
        "AH_CREDENTIALS": "${AH_CREDENTIALS:-}",
        "IMPORT_DATA": "true",
        "PORT": "3000",
        "UPLOAD_DIR": "/app-data/uploads",
        "MICROSOFT_CLIENT_ID": "${MICROSOFT_CLIENT_ID:-}",
        "MICROSOFT_CLIENT_SECRET": "${MICROSOFT_CLIENT_SECRET:-}",
        "MICROSOFT_TENANT_ID": "${MICROSOFT_TENANT_ID:-}",
        "B1_DATA_FOLDER": "/data/b1",
        "APP_DATA_FOLDER": "/data/app",
        "B1_DATABASE_URL": "${B1_DATABASE_URL:-postgres://${B1_DATABASE_CREDENTIALS:-}@b1_db_server:5432/b1?sslmode=disable}",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "B1_AUTOMATION_HUB_USER": "${B1_AUTOMATION_HUB_USER}",
        "B1_AUTOMATION_HUB_EMAIL": "${B1_AUTOMATION_HUB_EMAIL}",
        "B1_AUTOMATION_HUB_PASSWORD": "${B1_AUTOMATION_HUB_PASSWORD}",
        "AUTHENTICATION_TRUSTED_ORIGINS": "#globals.authenticationTrustedOrigins",
        "REPOSITORY_SERVICE_TYPE": "POSTGRES",
        "LEGACY_APPLICATION_APPURL": "#globals.appUrl",
        "LEGACY_AUTHENTICATION_ALLOWEDAUTHENTICATION": "${ALLOWED_AUTHENTICATION:-AkiomaUser}",
        "LEGACY_AUTHENTICATION_SSOAUTHENTICATIONURI": "#globals.authenticationURI",
        "LEGACY_AUTHENTICATION_AUTHENTICATIONOIDCROLEID": "#globals.authenticationOIDCRoleId",
        "LEGACY_ENVIRONMENT_URL": "#globals.appUrl",
        "LEGACY_INTEGRATION_GOOGLEAPIKEY": "${GOOGLEAPIKEY:-}",
        "LEGACY_INTEGRATION_KENDOLICENSEKEY": "${KENDO_LICENSE_KEY:-}"
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/app-data": "app-data"
      },
      "depends_on": {
        "b1_db_server": {
          "condition": "service_healthy"
        }
      }
    },
    "app_db_server": {
      "image": "#globals.postgresDbImage",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "app_db",
        "RESET_DATABASES": "${RESET_DATABASES:-FALSE}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "app_db_storage"
      }
    },
    "app_server_ts": {
      "image": "#globals.appServerTsImage",
      "restart": "unless-stopped",
      "environment": {
        "PORT": "3000",
        "APP_DATABASE_URL": "${APP_DATABASE_URL:-postgres://${APP_DATABASE_CREDENTIALS:-}@app_db_server:5432/app_db?sslmode=disable}",
        "BETTER_AUTH_SECRET": "${BETTER_AUTH_SECRET}",
        "NODE_ENV": "prod"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "app_db_server": {
          "condition": "service_healthy"
        }
      }
    },
    "n8n_db_server": {
      "image": "#globals.automationHubDBImage",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/wait_for_db.sh"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/var/lib/postgresql/data": "ah_db_storage"
      }
    },
    "n8n": {
      "image": "#globals.automationHubImage",
      "restart": "unless-stopped",
      "environment": {
        "AUTHENTICATION_URI": "#globals.authenticationURI",
        "DB_POSTGRESDB_HOST": "n8n_db_server",
        "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "false",
        "N8N_SECURE_COOKIE": "false",
        "WEBHOOK_URL": "https://${STACK}.${DOMAIN:-demo.build.one}/service/automation",
        "EXECUTIONS_MODE": "queue",
        "QUEUE_BULL_REDIS_HOST": "redis",
        "QUEUE_HEALTH_CHECK_ACTIVE": "true",
        "B1_N8N_ENV": "prod"
      },
      "networks": [
        "app-network"
      ],
      "depends_on": {
        "n8n_db_server": {
          "condition": "service_healthy"
        },
        "n8n_init_data": {
          "condition": "service_completed_successfully"
        }
      },
      "volumes": {
        "/workspace/data": "app-data",
        "/workspace/src/data/n8n": "n8n-data"
      }
    },
    "web-app": {
      "image": "#globals.webAppImage",
      "restart": "unless-stopped",
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "NODE_ENV": "production",
        "APP_URL": "#globals.appUrl"
      },
      "networks": [
        "app-network"
      ],
      "command": [
        "node",
        "dist/server/index.mjs"
      ]
    },
    "n8n_init_data": {
      "image": "#globals.dataImage",
      "restart": "no",
      "entrypoint": [
        "/workspace/src/data/.build/initialize_automation_hub_data.sh"
      ],
      "volumes": {
        "/update": "n8n-data"
      },
      "networks": [
        "app-network"
      ]
    },
    "redis": {
      "image": "redis:6-alpine",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      },
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/data": "redis_storage"
      }
    },
    "ah_worker": {
      "image": "#globals.automationHubImage",
      "scale": "${AH_NUM_WORKERS:-1}",
      "entrypoint": [
        "n8n",
        "worker"
      ],
      "depends_on": [
        "n8n"
      ],
      "environment": {
        "EXECUTIONS_MODE": "queue",
        "QUEUE_BULL_REDIS_HOST": "redis",
        "QUEUE_HEALTH_CHECK_ACTIVE": "true"
      },
      "restart": "unless-stopped",
      "networks": [
        "app-network"
      ],
      "volumes": {
        "/workspace/data/": "app-data"
      }
    }
  }
}
