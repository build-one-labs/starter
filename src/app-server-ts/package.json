{
  "name": "app-server-ts",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "g": "curl -X POST   http://localhost:3000/server-actions/schematics/generate    -H \"Authorization: Bearer ${SECHUB_TOKEN}\" -H \"Content-Type: application/json\"   -d '{\"name\":\"${1}\",\"action\":{\"name\":\"${2}\"},\"flat\":true, \"dryRun\":false}'\"",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate:generate": "drizzle-kit --config src/drizzle/drizzle.config.ts generate --name ",
    "db:migrate": "APP_DATABASE_URL=$(echo \"${APP_DATABASE_URL}\" | sed 's/app_db_server:5432/127.0.0.1:15432/') drizzle-kit --config src/drizzle/drizzle.config.ts migrate",
    "database:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@buildone/app-server-tslib": "24.3.0-VG.50",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.8",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.8",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.8",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/terminus": "^11.0.0",
    "axios": "^1.7.9",
    "change-case": "4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "drizzle-kit": "^0.30.5",
    "drizzle-orm": "^0.40.0",
    "memory-cache": "^0.2.0",
    "nestjs-cls": "^6.0.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pg": "^8.13.0",
    "qs": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.3",
    "@types/express": "^4.17.17",
    "@types/glob": "^8.1.0",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.5.2",
    "@types/memory-cache": "^0",
    "@types/node": "^22.0.0",
    "@types/passport": "^0",
    "@types/passport-http-bearer": "^1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "cpx": "^1.5.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "handlebars": "4.7.7",
    "jest": "^29.5.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-morph": "^25.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "webpack": "^5.94.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
